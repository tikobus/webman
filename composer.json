        "webman",
        "workerman",
        "framework",
        "skeleton",
        "project"
    ],
    "homepage": "https://github.com/tikobus/webman",
    "license": "MIT",
    "authors": [
        {
            "name": "tikobus"
        }
    ],
    "support": {
        "issues": "https://github.com/tikobus/webman/issues",
        "source": "https://github.com/tikobus/webman"
    },
    "require": {
        "php": ">=8.3"
    },
    "scripts": {
        "post-create-project-cmd": [
